  SpellName: "\u041F\u043B\u0430\u043D \u0411"
  SpellDescription: "\u041D\u0438\u043A\u0441 \u043E\u0433\u043B\u0443\u0448\u0430\u0435\u0442
    \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0445 \u0432\u0440\u0430\u0433\u043E\u0432,
    \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u0441\u043D\u0430\u0440\u044F\u0434\u044B
    \u0438 \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044F
    \u043A \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u0443. \u0421\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u0443\u0434\u0430\u0440 \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u0442
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u0438 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u041D\u0438\u043A\u0441\u0443
    1 HP, \u0435\u0441\u043B\u0438 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0440\u0430\u0441\u0441\u0443\u0434\u043A\u0430
    \u0438 \u0433\u043E\u0442\u043E\u0432\u0430 \u0430\u0432\u0442\u043E\u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430."
  StatsDescription: "\u041E\u0433\u043B\u0443\u0448\u0435\u043D\u0438\u0435: 1 \u0441\n\u0414\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
