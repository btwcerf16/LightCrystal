  EffectName: "\u0411\u0435\u0437\u0443\u043c\u0438\u0435"
  EffectDescription: "\u041a\u043e\u0448\u043c\u0430\u0440 \u0446\u0435\u043f\u043b\u044f\u0435\u0442\u0441\u044f \u0437\u0430 \u0440\u0430\u0437\u0443\u043c. \u0421\u0442\u0430\u0434\u0438\u0438 \u0443\u0441\u0438\u043b\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u043f\u0440\u0438 40%, 30%, 20% \u0438 10% \u0440\u0430\u0441\u0441\u0443\u0434\u043a\u0430. \u0412\u0441\u0435 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u044b\u0435 \u0448\u0442\u0440\u0430\u0444\u044b \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044f, \u043f\u043e\u043a\u0430 \u0440\u0430\u0441\u0441\u0443\u0434\u043e\u043a \u043d\u0435 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0434\u043e 50%. \u0411\u0435\u0437\u0443\u043c\u0438\u0435 \u043d\u0435\u043b\u044c\u0437\u044f \u0440\u0430\u0437\u0432\u0435\u044f\u0442\u044c."
  EffectStats: "40%: \u0434\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0437\u0440\u0435\u043d\u0438\u044f \u2212{ViewDistancePercent:0.#}%\n30%: \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0443\u0440\u043e\u043d \u2212{PhysicalDamagePercent:0.#}%, \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u0435 \u043c\u0430\u0433\u0438\u0438 \u2212{MagicAmplificationPercent:0.#}%\n20%: \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0438 \u043c\u0430\u0433\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0437\u0430\u0449\u0438\u0442\u0430 \u2212{ResistancePercent:0.#} \u043f.\u043f.\n10%: \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u2212{MoveSpeedPercent:0.#}%"
