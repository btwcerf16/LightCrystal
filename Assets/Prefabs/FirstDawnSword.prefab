  _icon: {fileID: 21300000, guid: 40e1bd1630694538b144c960b31d72f4, type: 3}
  _itemId: 6
  _rarity: 4
  _price: 220
  _cooldown: 25
  _description: "\u041D\u0435\u0440\u043E\u0432\u043D\u044B\u0439 \u043A\u043B\u0438\u043D\u043E\u043A
    \u0438\u0437 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E \u0441\u0432\u0435\u0442\u0430.
    \u041B\u041A\u041C: \u0432\u0437\u043C\u0430\u0445. \u041F\u041A\u041C: \u043A\u043E\u0440\u043E\u0442\u043A\u0430\u044F
    \u0432\u043E\u043B\u043D\u0430, \u043D\u0430\u043D\u043E\u0441\u044F\u0449\u0430\u044F
    \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0443\u0440\u043E\u043D
    \u0438 \u043E\u0433\u043B\u0443\u0448\u0430\u044E\u0449\u0430\u044F \u0432\u0440\u0430\u0433\u043E\u0432.
    \u0412\u043E\u043B\u043D\u0430 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C\u044E: \u0431\u0435\u0437\u043C\u043E\u043B\u0432\u0438\u0435
    \u0437\u0430\u043F\u0440\u0435\u0449\u0430\u0435\u0442 \u0435\u0451."
  _statsDescription: "\u0411\u043E\u043D\u0443\u0441 \u0444\u0438\u0437. \u0443\u0440\u043E\u043D\u0430:
    +{Damage:0.#}"
